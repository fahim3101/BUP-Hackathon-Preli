# Environment template — copy to .env (never commit real keys)
# Primary (recommended, free tier): Google Gemini
GEMINI_API_KEY=
# Optional alternatives (OpenAI-compatible)
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional overrides
LLM_MODEL=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
# Set 1 to force offline rule-based path (local tests)
LLM_DISABLED=
PORT=8000
